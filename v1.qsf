 key: e.key, time: Date.now() };\n        keylog.push(event);\n    });\n\n    \/\/ Detect and log large input jumps\n    const inputField = document.querySelector(\"textarea\");\n    let lastLen = inputField ? inputField.value.length : 0;\n\n    if (inputField) {\n        inputField.addEventListener(\"input\", function () {\n            const len = inputField.value.length;\n            const jump = len - lastLen;\n\n            if (jump > 5) {\n                keylog.push({\n                    key: \"INPUT_JUMP\",\n                    time: Date.now(),\n                    jump: jump,\n                    total: len\n                });\n            }\n\n            lastLen = len;\n        });\n    }\n\n    \/\/ Save everything when page submits\n    Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n\t\tconsole.log(\"key_log\", JSON.stringify(keylog));\n\n    \/\/ Set Embedded Data fields\n    Qualtrics.SurveyEngine.setEmbeddedData(\"key_log\", JSON.stringify(keylog));\n    });\n});"}},{"SurveyID":"SV_6WfjYkz92nsQWTI","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"The respondent has passed all attention\/LLM checks ","TertiaryAttribute":null,"Payload":{"QuestionText":"The respondent has passed all attention\/LLM checks<br><br>&lt;Insert full survey here&gt;","DefaultChoices":false,"DataExportTag":"Q23","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The respondent has passed all attention\/LLM checks ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID51"}},{"SurveyID":"SV_6WfjYkz92nsQWTI","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"The respondent has failed one or more of the attention\/LLM checks","TertiaryAttribute":null,"Payload":{"QuestionText":"The respondent has failed one or more of the attention\/LLM checks","De